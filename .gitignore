# Build output (exe, generated assets, embedded overlay DLL copy)
build/
*.exe
*.dll
*.pdb
*.lib
*.obj
*.o
*.res

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs and test output
*.log
test/*.json

# User settings and game files (never part of the source)
*.ini
SnowLauncher*.ini
card.ini
config.ini
lmnfig.ini

# Secrets
*.env
.env*
*.pem
*.key
*.pfx
token*.txt

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Custom Training: aerial's 2v2 Training Extension files shipped unmodified (embedded in the exe)
!third_party/training2v2/*.dll
!third_party/training2v2/*.ini
# Replays: M1kou's replay patch shipped unmodified with the author's permission (embedded in the exe)
!third_party/replay/*.dll
!third_party/replay/*.ini
